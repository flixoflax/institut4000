---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

type Props = {
  entry: CollectionEntry<"projects"> | CollectionEntry<"commissions">;
};

const { entry } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="relative group flex flex-col justify-end overflow-hidden h-56 sm:h-96 rounded-md border border-black/15 dark:border-white/20 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
>
  <!-- Optimized Image background with object-cover -->
  <Image
    src={entry.data.image}
    alt={entry.data.title || ""}
    width={1000}
    height={800}
    quality={80}
    format="webp"
    loading="lazy"
    decoding="async"
    fetchpriority="low"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Gradient overlay covering only bottom half -->
  <div
    class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/65 to-transparent"
  >
  </div>

  <!-- Content positioned at the bottom -->
  <div class="relative z-10 flex flex-col w-full p-4 pr-10 text-white">
    <div class="font-semibold">
      {entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
  </div>

  <!-- Arrow SVG -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute bottom-7 right-2 size-5 stroke-2 fill-none stroke-white"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
    ></polyline>
  </svg>
</a>
