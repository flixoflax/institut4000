---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";
import Container from "~/components/Container.astro";
import FormattedDate from "~/components/FormattedDate.astro";
import { readingTime } from "~/lib/utils";
import BackToPrev from "~/components/BackToPrev.astro";

export async function getStaticPaths() {
  const commissions = (await getCollection("commissions"))
    .filter((commission) => !commission.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return commissions.map((commission) => ({
    params: { slug: commission.slug },
    props: commission,
  }));
}
type Props = CollectionEntry<"commissions">;

const commission = Astro.props;
const { Content } = await commission.render();
---

<PageLayout
  title={commission.data.title}
  description={commission.data.description}
  clientLogo={commission.data.logo}
>
  <Container>
    <div class="animate">
      <BackToPrev href="/commissions"> Back to Commissions </BackToPrev>
    </div>
    <div class="flex flex-col gap-y-2 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={commission.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(commission.body)}
        </div>
      </div>

      <div class="animate text-4xl font-semibold text-black dark:text-white">
        {commission.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
