---
import { getCollection } from "astro:content";
import Container from "~/components/Container.astro";
import PageLayout from "~/layouts/PageLayout.astro";
import ArrowCard from "~/components/ArrowCard.astro";
import Link from "~/components/Link.astro";
import { dateRange } from "~/lib/utils";
import { SITE, HOME } from "~/consts";

// const blog = (await getCollection("blog"))
//   .filter(post => !post.data.draft)
//   .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
//   .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3); // Max 3 projects on homepage

const commissions = (await getCollection("commissions"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// const allwork = (await getCollection("work"))
//   .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
//   .slice(0,SITE.NUM_WORKS_ON_HOMEPAGE);

// const work = await Promise.all(
//   allwork.map(async (item) => {
//     const { Content } = await item.render();
//     return { ...item, Content };
//   })
// );
---

<PageLayout description={HOME.DESCRIPTION}>
  <Container>
    <div class="flex flex-col gap-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            <strong class="font-semibold text-black dark:text-white"
              >Institut 4000</strong
            > is the professional practice of <strong
              class="font-semibold text-black dark:text-white"
              >Niels Clormann</strong
            >, dedicated to exploring the intersection of development, design,
            and entrepreneurship.
          </p>
          <p class="animate">
            I build digital solutions through both independent projects and
            client commissions, with a commitment to purpose-driven
            functionality.
          </p>
          <p class="animate">
            Being a builder at heart, I approach each project with technical
            precision and creative thinking. My work focuses on creating
            meaningful solutions that address real needs or explore uncharted
            territories by combining solid engineering with thoughtful design.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Projects</h5>
          <Link href="/projects"> See all </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">Commissions</h5>
        </div>
        <ul class="flex flex-col gap-4">
          {
            commissions.map((commission) => (
              <li>
                <ArrowCard entry={commission} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Work & Education
          </h5>
        </div>
        <ul class="flex flex-col space-y-4">
          {
            // work.map((entry) => (
            //   <li>
            //     <div class="text-sm opacity-75">
            //       {dateRange(entry.data.dateStart, entry.data.dateEnd)}
            //     </div>
            //     <div class="font-semibold text-black dark:text-white">
            //       {entry.data.company}
            //     </div>
            //     <div class="text-sm opacity-75">{entry.data.role}</div>
            //     <article>
            //       <entry.Content />
            //     </article>
            //   </li>
            // ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">Let's Connect</h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say
            hi, reach out on <Link
              href="https://linkedin.com/in/niels-legolas-clormann"
              aria-label="Niels Clormann on LinkedIn"
              external
            >
              LinkedIn
            </Link> or send me an <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label="Astro Nano on Github"
            >
              email
            </Link>.
          </p>
        </article>
      </section>
    </div>
  </Container>
</PageLayout>
