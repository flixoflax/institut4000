---
import Head from "~/components/Head.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { SITE } from "~/consts";
import type { ImageFunction } from "astro:content";

type Props = {
  title?: string;
  clientLogo?: ImageMetadata;
  image?: string;
  description: string;
};

const { title, description, clientLogo, image } = Astro.props;
const actualTitle = title ? `${title} | ${SITE.NAME}` : SITE.NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={actualTitle} description={description} image={image} />
  </head>
  <body>
    <Header clientLogo={clientLogo} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
